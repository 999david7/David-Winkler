# Copy to .env. Everything is optional; without SMTP, messages are only
# saved to data/messages.json.

PORT=3000
# HOST=0.0.0.0

# Set to true behind a reverse proxy so rate limiting sees the real client IP.
# TRUST_PROXY=false

# Email delivery needs CONTACT_EMAIL plus SMTP_HOST, SMTP_USER and SMTP_PASS.
CONTACT_EMAIL=your@email.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=your@gmail.com
